# =========================================================
# RankingMJT .gitignore
# Public repository: be conservative, exclude anything sensitive.
# =========================================================

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*secret*
*credential*
id_rsa*
id_ed25519*
*.ssh/
EXPO_TOKEN
.npmrc
.pypirc

# --- Node ---
node_modules/
dist/
build/
.vite/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Expo / React Native ---
.expo/
.expo-shared/
*.jks
*.p8
*.mobileprovision
*.apk
*.aab
*.orig.*
mobile/.env
mobile/.env.*
!mobile/.env.example

# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/.env
backend/.env.*
!backend/.env.example

# --- Uploads / local data ---
backend/uploads/**
!backend/uploads/.gitkeep
!backend/uploads/monsters/
!backend/uploads/monsters/.gitkeep

# --- Databases / local data dirs ---
*.sqlite3
*.db
pgdata/
postgres-data/

# --- Backups (produced by scripts/backup_*.sh, contain real data dumps) ---
backups/
*.dump

# --- Logs / caches ---
*.log
logs/
.cache/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
