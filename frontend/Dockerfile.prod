# Production build: compiles the Vite app, then serves the static bundle
# with nginx and proxies /api and /uploads to the api service. No dev
# bind-mounts, no vite dev server, no backend host/port baked into the JS
# (the app only ever calls same-origin relative paths).

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
