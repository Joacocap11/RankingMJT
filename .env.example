# =========================================================
# RankingMJT - root environment example (docker-compose)
# Copy to .env and adjust for your local machine.
# NEVER commit the real .env file.
# All values below are safe local-only placeholders.
# =========================================================

# --- Postgres (local dev only) ---
POSTGRES_USER=rankingmjt
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=rankingmjt
POSTGRES_PORT=5433

# --- API ---
API_PORT=8003
DATABASE_URL=postgresql+psycopg://rankingmjt:changeme_local_only@db:5432/rankingmjt
CORS_ORIGINS=http://localhost:3003
UPLOAD_MAX_MB=5

# --- Web frontend ---
WEB_PORT=3003
# Target the vite dev-server proxy points to (docker network service name)
VITE_PROXY_TARGET=http://api:8000
