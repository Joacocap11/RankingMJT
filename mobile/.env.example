# RankingMJT mobile app environment variables.
# Copy to `.env` and uncomment the ONE line matching how you run the app.
# Expo only exposes vars prefixed EXPO_PUBLIC_ to client code (baked in at build/start time).

# --- Web / iOS Simulator (host machine can reach localhost directly) ---
EXPO_PUBLIC_API_BASE_URL=http://localhost:8003/api/v1

# --- Android Emulator (emulator's alias for the host machine's localhost) ---
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8003/api/v1

# --- Physical device on the same LAN as the API (dev only) ---
# Replace 192.168.1.100 with your machine's actual LAN IP (placeholder shown, never commit a real IP).
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8003/api/v1
